SAYAC EQU 30H

ORG 0000H
	
MOV 60H,#001H
MOV 61H,#002H
MOV 62H,#003H
MOV 63H,#004H
MOV 64H,#005H
MOV 65H,#006H
MOV 66H,#007H
MOV 67H,#008H
MOV 68H,#009H
MOV 69H,#00AH
MOV 6AH,#00BH

SJMP TRANSFER

TRANSFER:
MOV R0,#60H
MOV A,R0
ADD A,#00BH
MOV R0,A

MOV R1,#040H
MOV A,R1
ADD A,#00BH
MOV R1,A
MOV SAYAC,#00BH

DONGU:
MOV A,@R0
MOV @R1,A
DEC R0
DEC R1

DJNZ SAYAC, DONGU

SON:
SJMP SON

END

