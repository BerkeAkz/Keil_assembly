SAYAC EQU 30H
ORG 00H
	
MOV 040H,#001H
MOV 041H,#002H
MOV 042H,#003H
MOV 043H,#004H
MOV 044H,#005H
MOV 045H,#006H
MOV 046H,#007H
MOV 047H,#008H
MOV 048H,#009H
MOV 049H,#00AH
MOV 04AH,#00BH

SJMP TRANSFER

TRANSFER:

MOV R0,#40H
MOV R1,#45H
MOV SAYAC,#00BH

DONGU:
MOV A,@R0
MOV @R1,A

INC R0
INC R1

DJNZ SAYAC,DONGU

SON:
SJMP SON

END