ORG 00H
	BASLA:
	MOV A,P1
	ANL A,#03H
	RL A
	
	MOV DPTR,#SECENEKLER
	JMP @ A+DPTR
	
	SECENEKLER:
	AJMP SU_VER          ;A=0 ISE BURAYA GIRER 
	AJMP CAY_VER         ;A=1 ISE BURAYA GIRER
	AJMP KAHVE_VER       ;A=2 ISE BURAYA GIRER
	AJMP MEYVE_SUYU_VER  ;A=3 ISE BURAYA GIRER
	
	SU_VER: MOV P2,#01H
	        SJMP ISLEM_BITTI
	CAY_VER: MOV P2,#02H
	        SJMP ISLEM_BITTI
	kAHVE_VER: MOV P2,#03H
	        SJMP ISLEM_BITTI
	MEYVE_SUYU_VER: MOV P2,#01H
	        SJMP ISLEM_BITTI
	
	ISLEM_BITTI:
	SJMP BASLA
			