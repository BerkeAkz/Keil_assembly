SAYAC EQU 030H
	
ORG 0000H
	
MOV 40H,#001H
MOV 41H,#002H
MOV 42H,#003H
MOV 43H,#004H
MOV 44H,#005H
MOV 45H,#006H
MOV 46H,#007H
MOV 47H,#008H
MOV 48H,#009H
MOV 49H,#00AH
MOV 4AH,#00BH

SJMP TRANSFER

TRANSFER:
MOV R0,#40H
MOV R1,#60H

MOV SAYAC,#0AH

DONGU:

MOV A,@R0
MOV @R1,A

INC R0
INC R1

DJNZ SAYAC,DONGU

SON:
SJMP SON

END